{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "type": "AdaptiveCard",
  "body": [
    {
      "type": "Image",
      "url": "${imageUrl}"
    },
    {
      "type": "TextBlock",
      "text": "${title}",
      "wrap": true,
      "horizontalAlignment": "Center",
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "Image Details",
      "spacing": "Medium",
      "separator": true,
      "size": "Large",
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "${description}",
      "wrap": true,
      "spacing": "Small"
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "NASA ID:",
          "value": "${nasaId}"
        },
        {
          "title": "Center:",
          "value": "${center}"
        },
        {
          "title": "Date created:",
          "value": "${dateCreated}"
        }
      ]
    }
  ]
}
